{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "test/**/*.mts",
    "integration/**/*.ts",
    "integration/**/*.mts"
  ],
  "exclude": ["dist", ".test-dist", "node_modules"]
}
